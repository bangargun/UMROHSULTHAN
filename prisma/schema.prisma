generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(uuid())
  name          String
  username      String    @unique @default("master")
  password      String    @default("1234")
  plainPassword String?   @default("1234")
  email         String?
  phone         String?
  role          String    @default("SUPERADMIN") // SUPERADMIN, ADMIN_OPERASIONAL, ADMIN_FINANCE, ADMIN_MARKETING, STAF_LOGISTIK, PILGRIM
  avatar        String?
  isActive      Boolean   @default(true)
  lastLogin     DateTime?
  pilgrimId     String?   @unique
  pilgrim       Pilgrim?  @relation(fields: [pilgrimId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model TravelSetting {
  id                  String   @id @default("default-settings")
  companyName         String   @default("PT SULTHAN HARAMAIN TOUR & TRAVEL")
  licenseNumber       String   @default("PPIU Kemenag RI No. U.412 Tahun 2022")
  kemenhanLicense     String?  @default("Izin Khusus Kemenhan RI No. B/108/M/XII/2023")
  address             String   @default("Sulthan Haramain Tower, Jl. Prof. Dr. Satrio No. 88, Kuningan, Jakarta Selatan 12940")
  phone               String   @default("(021) 5290-8888 / 0811-9876-5432")
  email               String   @default("salam@sulthanharamain.com")
  website             String   @default("www.sulthanharamain.com")
  directorName        String   @default("H. Sulthan Syarif, Lc., M.A.")
  directorTitle       String   @default("Direktur Utama")
  bankBSI             String   @default("8888-999-123 a.n PT SULTHAN HARAMAIN TOUR & TRAVEL")
  bankBCA             String   @default("731-888-9900 a.n PT SULTHAN HARAMAIN TOUR & TRAVEL")
  bankMandiri         String   @default("137-00-8888999-1 a.n PT SULTHAN HARAMAIN TOUR & TRAVEL")
  googleDriveFolderId String?  @default("161j-oTJ8WgbCYRKsxXCST3wE7CAHU3XY")
  updatedAt           DateTime @updatedAt
}

model RequirementTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isMandatory Boolean  @default(true)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Package {
  id                 String         @id @default(uuid())
  code               String         @unique
  name               String
  description        String?
  departureDate      DateTime
  returnDate         DateTime
  durationDays       Int            @default(9)
  hotelMakkah        String
  hotelMadinah       String
  airline            String
  priceQuad          Float
  priceTriple        Float
  priceDouble        Float
  quota              Int
  bookedCount        Int            @default(0)
  commissionAgent    Float          @default(1500000) // Komisi Mitra / Agen per Pax
  commissionReferral Float          @default(500000)  // Komisi Referral Alumni per Pax
  status             String         @default("ACTIVE") // ACTIVE, FULL, COMPLETED, DRAFT
  pilgrims           Pilgrim[]
  leads              Lead[]
  expenses           Expense[]
  itineraries        ItineraryDay[]
  registrations      Registration[]
  savingsAccounts    SavingsAccount[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Lead {
  id                  String            @id @default(uuid())
  name                String
  phone               String
  email               String?
  city                String?
  source              String            @default("INSTAGRAM") // INSTAGRAM, TIKTOK, WEBSITE, REFERRAL, WALK_IN, AGENT
  agentName           String?           // Nama Agen / Mitra Lapangan jika sumber = AGENT
  referralPilgrimName String?           // Nama Jamaah / Alumni Perujuk jika sumber = REFERRAL
  packageId           String?           // Paket Umroh yang Diminati
  package             Package?          @relation(fields: [packageId], references: [id], onDelete: SetNull)
  status              String            @default("NEW") // NEW, CONTACTED, INTERESTED, QUOTATION_SENT, CLOSING_DP, LOST
  notes               String?
  budget              Float?
  estimatedPax        Int               @default(1)
  assignedAgent       String?
  interactions        LeadInteraction[]
  pilgrim             Pilgrim?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model LeadInteraction {
  id                String    @id @default(uuid())
  leadId            String
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type              String    @default("WHATSAPP") // CALL, WHATSAPP, MEETING, EMAIL
  summary           String
  nextFollowUpDate  DateTime?
  createdAt         DateTime  @default(now())
}

model Pilgrim {
  id                    String                @id @default(uuid())
  leadId                String?               @unique
  lead                  Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  packageId             String
  package               Package               @relation(fields: [packageId], references: [id])
  
  // Data Identitas & Pribadi (Standar SISKOPATUH)
  title                 String?   @default("Bpk") // Bpk, Ibu, Sdr, Sdri, H., Hj., Ustadz, Dr., dll
  name                  String    // Nama Sesuai Kartu Vaksin & Paspor
  fatherName            String?   // Nama Ayah Kandung (untuk endorsement 3 kata & paspor)
  identityType          String?   @default("KTP") // KTP, PASPOR, KITAS, SIM
  nik                   String    @unique // No Identitas / NIK

  // Data Paspor RI
  passportName          String?   // Nama Lengkap pada Paspor
  passportNumber        String?   // Nomor Paspor RI
  passportIssuedDate    DateTime? // Tanggal Dikeluarkan Paspor
  passportIssuedCity    String?   // Kota / Kantor Imigrasi Penerbit Paspor
  passportExpiry        DateTime? // Tanggal Habis Berlaku Paspor

  // Data Kelahiran
  placeOfBirth          String?   // Tempat Lahir
  dateOfBirth           DateTime? // Tanggal Lahir
  gender                String    @default("MALE") // MALE, FEMALE

  // Alamat Lengkap Domisili
  address               String?   // Alamat Jalan / Dusun / RT RW
  subDistrict           String?   // Kelurahan / Desa
  district              String?   // Kecamatan
  city                  String?   // Kabupaten / Kota
  province              String?   // Provinsi

  // Kontak
  telephone             String?   // Nomor Telepon Rumah / Kantor
  phone                 String    // Nomor Handphone / WhatsApp Utama
  email                 String?   // Email

  // Demografi & Sosial
  citizenship           String?   @default("WNI") // Kewarganegaraan: WNI / WNA
  maritalStatus         String?   // Status Pernikahan: Belum Menikah, Menikah, Cerai Hidup, Cerai Mati
  education             String?   // Pendidikan: SD, SMP, SMA, D3, S1, S2, S3, Lainnya
  job                   String?   // Pekerjaan: PNS, TNI/POLRI, Swasta, Wiraswasta, Ibu Rumah Tangga, Pensiunan, dll

  // Data Visa & Legalitas Saudi
  visaProvider          String?   // Provider / Penjamin Visa Umroh
  visaNumber            String?   // Nomor E-Visa Umroh / Visa MoFA Saudi
  visaIssueDate         DateTime? // Tanggal Terbit / Berlaku Visa
  visaExpiryDate        DateTime? // Tanggal Akhir Masa Berlaku Visa
  mofaNumber            String?   // Nomor MOFA Saudi
  muassasahName         String?   // Nama Syarikah / Muassasah Penjamin di Arab Saudi
  insuranceNumber       String?   // Nomor Asuransi Kesehatan Saudi

  // Orang Tua Kandung & Mahram
  motherName            String?   // Nama Ibu Kandung
  emergencyContactName  String?
  emergencyContactPhone String?
  mahramName            String?
  mahramRelation        String?
  
  // Preferensi
  roomType              String                @default("QUAD") // QUAD, TRIPLE, DOUBLE
  uniformSize           String                @default("L") // S, M, L, XL, XXL, XXXL
  bloodType             String?
  healthNotes           String?
  
  // Status
  status                String                @default("REGISTERED") // REGISTERED, DP_PAID, FULLY_PAID, DOCUMENTS_READY, VISA_ISSUED, DEPARTED, RETURNED

  // Akun Portal & Password Jamaah
  portalPassword        String?               @default("123456")
  user                  User?
  
  // Relations
  invoices              Invoice[]
  handovers             LogisticsHandover[]
  requirements          PilgrimRequirement[]
  letters               OfficialLetter[]
  
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  pilgrimId     String
  pilgrim       Pilgrim   @relation(fields: [pilgrimId], references: [id], onDelete: Cascade)
  type          String    @default("DP") // DP, INSTALLMENT, FULL_PAYMENT
  title         String
  amount        Float
  dueDate       DateTime
  status        String    @default("PENDING") // PENDING, PAID, OVERDUE, CANCELLED
  paymentMethod String?   // BANK_TRANSFER, CASH, QRIS
  paymentDate   DateTime?
  proofUrl      String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Expense {
  id              String    @id @default(uuid())
  packageId       String?
  package         Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  category        String    @default("OPERASIONAL_KANTOR") // TIKET_PESAWAT, HOTEL_SAUDI, VISA_ASURANSI, LOGISTIK_VENDOR, MUTHAWWIF_HANDLING, MARKETING_IKLAN, OPERASIONAL_KANTOR
  title           String
  amount          Float
  expenseDate     DateTime  @default(now())
  paymentMethod   String    @default("BANK_TRANSFER") // BANK_TRANSFER, CASH, CREDIT_CARD
  recipientVendor String?
  notes           String?
  proofUrl        String?
  createdBy       String    @default("Admin Keuangan")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Equipment {
  id             String            @id @default(uuid())
  name           String
  sku            String            @unique
  category       String            @default("AKSESORIS") // BAGASI, KAIN, SERAGAM, AKSESORIS, DOKUMEN
  totalStock     Int               @default(0)
  availableStock Int               @default(0)
  unit           String            @default("PCS") // PCS, SET, LEMBAR
  minStockAlert  Int               @default(10)
  description    String?
  movements      StockMovement[]
  handoverItems  HandoverItem[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model StockMovement {
  id           String    @id @default(uuid())
  equipmentId  String
  equipment    Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  type         String    @default("IN_PURCHASE") // IN_PURCHASE, OUT_DISTRIBUTION, RETURN, ADJUSTMENT
  quantity     Int
  referenceNo  String?
  notes        String?
  createdBy    String?
  movementDate DateTime  @default(now())
  createdAt    DateTime  @default(now())
}

model LogisticsHandover {
  id            String         @id @default(uuid())
  pilgrimId     String
  pilgrim       Pilgrim        @relation(fields: [pilgrimId], references: [id], onDelete: Cascade)
  handoverDate  DateTime       @default(now())
  officerName   String
  recipientName String
  signatureUrl  String?        // Base64 Signature Image or data URL
  notes         String?
  isCompleted   Boolean        @default(false)
  items         HandoverItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model HandoverItem {
  id          String            @id @default(uuid())
  handoverId  String
  handover    LogisticsHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment         @relation(fields: [equipmentId], references: [id])
  quantity    Int               @default(1)
  isGiven     Boolean           @default(false)
  notes       String?
}

model PilgrimRequirement {
  id          String    @id @default(uuid())
  pilgrimId   String
  pilgrim     Pilgrim   @relation(fields: [pilgrimId], references: [id], onDelete: Cascade)
  name        String    // e.g. "Paspor Asli (Min 8 Bulan)", "Buku Kuning Vaksin Meningitis", "Pasfoto 4x6 Latar Putih (80% Wajah)", "Fotokopi KTP & KK", "Buku Nikah / Akta Lahir"
  isSubmitted Boolean   @default(false)
  isVerified  Boolean   @default(false)
  notes       String?
  fileUrl     String?
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model OfficialLetter {
  id                     String    @id @default(uuid())
  letterNumber           String    @unique
  pilgrimId              String
  pilgrim                Pilgrim   @relation(fields: [pilgrimId], references: [id], onDelete: Cascade)
  type                   String    // SURAT_REKOMENDASI_PASPOR, SURAT_ENDORSEMENT_PASPOR, SURAT_IZIN_CUTI, SURAT_PENGANTAR_KEMENAG, SURAT_KETERANGAN_JAMAAH, SURAT_CUSTOM
  customTitle            String?   // For custom letter type or override
  customSubject          String?   // Perihal / Hal Surat
  customBody             String?   // Custom body paragraph
  destinationInstitution String    // Kantor Imigrasi / PT ABC / Kemenag Kota
  applicantJobTitle      String?   // Jabatan untuk surat cuti (e.g., Guru, Karyawan, PNS)
  letterCity             String?   @default("Tebing Tinggi") // Kota Tempat Diterbitkan Surat
  customNotes            String?
  issueDate              DateTime  @default(now())
  generatedBy            String    @default("Admin Travel")
  createdAt              DateTime  @default(now())
}

model ChartOfAccount {
  id            String    @id @default(uuid())
  code          String    @unique // e.g. "1101", "4101", "5101", "6101"
  name          String    // e.g. "Kas Utama", "Pendapatan Paket Umroh Reguler", "Beban Tiket & Maskapai"
  category      String    // ASSET, LIABILITY, EQUITY, REVENUE, HPP_EXPENSE, OPEX_EXPENSE
  group         String    // e.g. "Kas & Bank", "Pendapatan Operasional", "Beban Pokok Penjualan (HPP)", "Beban Operasional & Kantor"
  normalBalance String    @default("DEBIT") // DEBIT, CREDIT
  description   String?
  isActive      Boolean   @default(true)
  orderIndex    Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model LetterTemplate {
  id             String   @id @default(uuid())
  code           String   @unique // e.g. "ENDOS", "PASPOR", "CUTI", "KEMENAG", "JAMAAH", "MAHRAM", "RESMI"
  typeKey        String   @unique // e.g. "SURAT_ENDORSEMENT_PASPOR", "SURAT_REKOMENDASI_PASPOR", etc.
  title          String   // e.g. "Surat Permohonan Endos Nama di Paspor"
  subject        String   // e.g. "Permohonan Penambahan / Endorsement Nama di Paspor"
  defaultDest    String   // e.g. "Kepala Kantor Imigrasi Kelas I / II TPI"
  defaultNotes   String?  // e.g. "Penambahan nama menjadi 3 suku kata..."
  bodyTemplate   String?  // Template paragraf isi surat
  orderIndex     Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model JournalEntry {
  id              String             @id @default(uuid())
  entryNumber     String             @unique // e.g. "JU-202608-0001"
  transactionDate DateTime           @default(now())
  description     String             // Keterangan transaksi
  referenceNo     String?            // No Ref / Invoice / Kwitansi / PO
  sourceModule    String?            // "MANUAL", "INVOICE", "EXPENSE"
  sourceId        String?
  lines           JournalEntryLine[]
  createdBy       String             @default("Admin Akuntansi")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model JournalEntryLine {
  id              String         @id @default(uuid())
  journalEntryId  String
  journalEntry    JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountCode     String         // e.g. "1102"
  accountName     String         // e.g. "Bank Syariah Indonesia (BSI)"
  accountCategory String         // ASSET, LIABILITY, EQUITY, REVENUE, HPP_EXPENSE, OPEX_EXPENSE
  debit           Float          @default(0)
  credit          Float          @default(0)
  memo            String?
  createdAt       DateTime       @default(now())
}

model AppRole {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. "SUPERADMIN", "ADMIN_OPERASIONAL", etc.
  name        String           // e.g. "Superadmin (Akses Penuh)", "Admin Operasional", etc.
  description String?
  badgeColor  String           @default("bg-slate-100 text-slate-800")
  isSystem    Boolean          @default(false)
  orderIndex  Int              @default(1)
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id          String   @id @default(uuid())
  roleKey     String   // SUPERADMIN, ADMIN_OPERASIONAL, etc.
  roleId      String?
  role        AppRole? @relation(fields: [roleId], references: [id], onDelete: Cascade)
  moduleKey   String   // dashboard, leads, pilgrims, alumni, finance, profit-loss, logistics, handovers, requirements, letters, agents, master, settings
  moduleName  String   // Dashboard & Analitik, Marketing & Leads, etc.
  canView     Boolean  @default(true)
  canCreate   Boolean  @default(false)
  canEdit     Boolean  @default(false)
  canDelete   Boolean  @default(false)
  canExport   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([roleKey, moduleKey])
}

model Agent {
  id                    String   @id @default(uuid())
  name                  String
  phone                 String   @unique
  city                  String   @default("Jakarta")
  referralCode          String   @unique
  commissionPerPax      Float    @default(1500000)
  totalClosingPax       Int      @default(0)
  totalCommissionEarned Float    @default(0)
  paidCommission        Float    @default(0)
  pendingCommission     Float    @default(0)
  bankName              String?  @default("BSI")
  accountNumber         String?
  accountHolder         String?
  status                String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Branch {
  id        String   @id @default(uuid())
  code      String   @unique // e.g. "SULTHAN-BDG"
  name      String   // e.g. "Kantor Cabang Bandung"
  city      String   @default("Bandung")
  address   String?
  headName  String?  // Kepala Cabang
  phone     String?
  email     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MasterHotel {
  id        String   @id @default(uuid())
  name      String   // e.g. "Pullman Zamzam (Bintang 5)"
  city      String   // "MAKKAH" or "MADINAH"
  rating    Int      @default(5)
  distance  String?  // e.g. "Depan Pelataran Masjidil Haram"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, city])
}

model MasterAirline {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "Saudia Airlines (Direct CGK-JED)"
  code      String?  // e.g. "SV"
  routeType String?  @default("DIRECT") // DIRECT, TRANSIT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalesFaq {
  id          String   @id @default(uuid())
  category    String   // CLOSING_OBJECTION, COMPLAINT_HANDLING, FAQ_UMUM, SYARAT_VISA, FASILITAS_HOTEL, REFUND_KEUANGAN
  title       String   // e.g. "Objection: Harga Terlalu Mahal Dibanding Travel Lain"
  question    String   // The customer objection or question
  answer      String   // Internal explanation / key points
  waScript    String?  // Ready-to-copy WhatsApp script
  tags        String?  // e.g. "harga, promo, closing, diskon"
  isMandatory Boolean  @default(true)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RoomAllocation {
  id          String   @id @default(uuid())
  packageId   String
  hotelCity   String   // "MAKKAH" or "MADINAH"
  hotelName   String?
  roomNumber  String   // e.g. "1204"
  roomType    String   @default("QUAD") // QUAD, TRIPLE, DOUBLE, SINGLE
  floor       String?  // e.g. "Lantai 12"
  pilgrimIds  String   // JSON array of pilgrim IDs
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BusAllocation {
  id              String   @id @default(uuid())
  packageId       String
  busNumber       String   // e.g. "BUS-01", "BUS-02"
  busName         String?  // e.g. "Dallah VIP Coach"
  capacity        Int      @default(45)
  driverName      String?
  driverPhone     String?
  tourLeaderName  String?
  muthawwifName   String?
  pilgrimIds      String   // JSON array of pilgrim IDs
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GroundAttendance {
  id                 String   @id @default(uuid())
  packageId          String
  eventName          String   // e.g. "Keberangkatan CGK", "Check-in Hotel Madinah", "Ziarah Raudhah", "Tawaf & Sai", "City Tour Makkah", "Kepulangan Jeddah"
  eventDate          DateTime @default(now())
  checkedPilgrimIds  String   // JSON array of pilgrim IDs who are present
  notes              String?
  conductedBy        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model WhatsappConfig {
  id                    String   @id @default("default-wa")
  provider              String   @default("FONNTE") // FONNTE, WABA, CUSTOM
  apiKey                String?
  senderPhone           String?
  isConnected           Boolean  @default(false)
  autoRemindersEnabled  Boolean  @default(true)
  templatesJson         String?  // JSON customized templates
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model PaymentGatewayConfig {
  id                 String   @id @default("default-pg")
  provider           String   @default("MIDTRANS") // MIDTRANS, XENDIT, DUITKU
  merchantId         String?
  clientKey          String?
  serverKey          String?
  isSandbox          Boolean  @default(true)
  activeChannelsJson String?  // JSON array e.g. ["BSI_VA", "MANDIRI_VA", "BCA_VA", "QRIS"]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AgentCommissionPayout {
  id             String    @id @default(uuid())
  agentId        String
  packageId      String?
  pilgrimId      String?
  amount         Float
  status         String    @default("PENDING_DEPARTURE") // PENDING_DEPARTURE, APPROVED, PAID, REJECTED
  payoutDate     DateTime?
  paymentProof   String?   // URL or receipt note
  journalEntryId String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ItineraryDay {
  id          String    @id @default(uuid())
  packageId   String
  package     Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  dayNumber   Int       // 1, 2, 3...
  date        DateTime?
  title       String
  time        String?   // e.g. "08:00 WSA"
  location    String?   // e.g. "Masjid Nabawi / Hotel Madinah"
  dresscode   String?   // e.g. "Batik Travel Resmi"
  mealPlan    String?   // e.g. "Sarapan, Makan Siang & Malam Hotel"
  description String?   // Detailed Rundown
  notes       String?   // Catatan Muthawwif / Tips
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([packageId, dayNumber])
}

model Registration {
  id                  String    @id @default(uuid())
  regNumber           String    @unique // REG-2608-0001
  idJamaah            String    // JAM-2608-0001
  
  // Data Identitas & Pribadi (Standar SISKOPATUH)
  title               String?   @default("Bpk") // Bpk, Ibu, Sdr, Sdri, H., Hj., Ustadz, Dr., dll
  fullName            String    // Nama Sesuai Kartu Vaksin & Paspor
  fatherName          String?   // Nama Ayah Kandung
  identityType        String?   @default("KTP") // KTP, PASPOR, KITAS, SIM
  nik                 String    // No Identitas / NIK
  
  // Data Paspor RI (Kondisional)
  hasPassport         Boolean   @default(false) // Apakah paspor sudah ada?
  passportName        String?   // Nama pada Paspor
  passportNumber      String?   // Nomor Paspor RI
  passportIssuedDate  DateTime? // Tanggal Dikeluarkan Paspor
  passportIssuedCity  String?   // Kota / Kantor Imigrasi Penerbit Paspor
  passportExpiry      DateTime? // Tanggal Habis Berlaku Paspor

  // Data Kelahiran & Alamat
  placeOfBirth        String?
  dateOfBirth         DateTime?
  gender              String    @default("MALE") // MALE, FEMALE
  address             String?   // Alamat Jalan / RT RW
  subDistrict         String?   // Kelurahan / Desa
  district            String?   // Kecamatan
  city                String?   // Kabupaten / Kota
  province            String?   // Provinsi
  
  // Kontak & Demografi
  telephone           String?   // Nomor Telepon Rumah / Kantor
  phone               String    // Nomor HP / WhatsApp
  email               String?
  citizenship         String?   @default("WNI") // Kewarganegaraan
  maritalStatus       String?   // Status Pernikahan
  education           String?   // Pendidikan
  job                 String?   // Pekerjaan
  
  // Paket & Kamar
  packageId           String
  package             Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  roomType            String    @default("QUAD") // QUAD, TRIPLE, DOUBLE
  pricePackage        Float     @default(0)
  dpAmount            Float     @default(5000000)
  
  // Ukuran Baju & Kesehatan
  uniformSize          String    @default("L") // S, M, L, XL, XXL, XXXL, Custom
  chronicDiseases      String?   // e.g. "Hipertensi, Diabetes Melitus, Stroke Ringan"
  wheelchairAssistance Boolean   @default(false)
  wheelchairNotes      String?   // e.g. "Bawa sendiri" / "Perlu sewa pendorong di Mekkah"

  // Riwayat Pengalaman Umroh
  umrahExperienceCount String    @default("BELUM_PERNAH") // BELUM_PERNAH, 1_KALI, 2_KALI, 3_KALI, LEBIH_DARI_3_KALI
  isPreviousClient     Boolean   @default(false)
  previousPackageName  String?   // Program umroh sebelumnya jika alumni Sulthan Haramain

  // Jalur Pendaftaran & Referral
  channel             String    @default("DIRECT") // DIRECT, AGENT, REFERRAL
  agentId             String?
  agentName           String?
  referralName        String?
  leadId              String?   // Terkoneksi ke Leads CRM

  // Dokumen Unggahan Google Drive (5 Berkas)
  ktpFileUrl          String?   // 1. Berkas KTP
  familyCardFileUrl   String?   // 2. Berkas Kartu Keluarga (KK)
  passportFileUrl     String?   // 3. Berkas Paspor (jika ada)
  diplomaFileUrl      String?   // 4. Berkas Ijazah (jika ada)
  marriageBookFileUrl String?   // 5. Berkas Buku Nikah (jika ada)
  transferProofUrl    String?   // Bukti Transfer DP
  googleDriveFolderId String?
  
  // Lifecycle Status
  status              String    @default("NEW") // NEW, VERIFIED, PAYMENT_PENDING, PAID, REJECTED
  rejectionReason     String?
  verifiedAt          DateTime?
  paidAt              DateTime?
  
  // Relasi Pilgrim & Invoice
  pilgrimId           String?   @unique
  invoiceNumber       String?
  
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model SavingsAccount {
  id                    String               @id @default(uuid())
  accountNumber         String               @unique // e.g. TAB-2608-0001
  fullName              String
  phone                 String
  email                 String?
  nik                   String
  gender                String               @default("MALE") // MALE, FEMALE
  address               String?
  city                  String?
  province              String?
  uniformSize           String               @default("L") // S, M, L, XL, XXL, XXXL, Custom
  
  // Program Paket Target
  targetPackageId       String?
  targetPackage         Package?             @relation(fields: [targetPackageId], references: [id], onDelete: SetNull)
  targetPackageName     String               // e.g. "UMROH REGULER SEPTEMBER 2026 (QUAD)"
  targetAmount          Float                // Total target biaya paket, e.g. 31500000
  
  // Saldo & Status Perlengkapan Koper
  initialDeposit        Float                @default(2000000) // DP Awal Rp 2.000.000
  totalBalance          Float                @default(2000000) // Total saldo saat ini
  equipmentReceived     Boolean              @default(true)    // Koper & perlengkapan sudah diterima
  equipmentHandoverDate DateTime?            @default(now())
  
  // Lifecycle Status
  status                String               @default("ACTIVE") // ACTIVE, TARGET_REACHED, CONVERTED_TO_PILGRIM, CANCELLED
  convertedAt           DateTime?
  pilgrimId             String?              @unique
  
  channel               String               @default("DIRECT") // DIRECT, AGENT, REFERRAL
  agentId               String?
  agentName             String?
  referralName          String?
  
  // Dokumen & Bukti Google Drive
  ktpFileUrl            String?
  transferProofUrl      String?
  googleDriveFolderId   String?
  
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  
  transactions          SavingsTransaction[]
}

model SavingsTransaction {
  id                   String               @id @default(uuid())
  savingsAccountId     String
  savingsAccount       SavingsAccount       @relation(fields: [savingsAccountId], references: [id], onDelete: Cascade)
  receiptNumber        String               @unique // e.g. KWT-TAB-2608-0001
  amount               Float                // Nominal setoran saat ini, e.g. 1000000
  currentBalance       Float                // Total saldo setelah setoran ini
  remainingAmount      Float                // Sisa kekurangan dana menuju target
  paymentMethod        String               @default("BANK_TRANSFER") // BANK_TRANSFER, CASH, QRIS
  transactionDate      DateTime             @default(now())
  proofUrl             String?
  notes                String?
  officerName          String?              @default("Admin Keuangan")
  createdAt            DateTime             @default(now())
}

model BadalUmroh {
  id                   String    @id @default(uuid())
  orderNumber          String    @unique // BDL-2608-0001

  // Data Pemesan (Keluarga / Ahli Waris)
  ordererName          String
  ordererPhone         String
  ordererEmail         String?
  ordererNik           String?
  ordererAddress       String?
  ordererCity          String?
  ordererRelation      String    // ANAK, SUAMI, ISTRI, CUCU, SAUDARA, KEPONAKAN, LAINNYA

  // Data Almarhum / Yang Dibadalkan
  recipientName        String    // Nama almarhum / yang mau dibadalkan
  recipientGender      String    @default("MALE") // MALE, FEMALE
  recipientStatus      String    @default("DECEASED") // DECEASED, ALIVE_DISABLED
  recipientBirthPlace  String?
  recipientDateOfBirth DateTime?

  // Paket & Harga
  packageType          String    @default("BADAL_BASIC") // BADAL_BASIC, BADAL_PREMIUM, BADAL_WITH_VIDEO
  price                Float     @default(3500000)
  dpAmount             Float     @default(0)

  // Pelaksana Badal (di Saudi)
  executorName         String?
  executorPhone        String?

  // Status & Tracking
  // PENDING_PAYMENT → PAYMENT_RECEIVED → SCHEDULED → IN_PROGRESS → COMPLETED → CERTIFICATE_ISSUED
  status               String    @default("PENDING_PAYMENT")

  scheduledDate        DateTime?
  completedAt          DateTime?

  // Bukti & Dokumentasi
  transferProofUrl     String?
  executionPhotoUrl    String?
  executionVideoUrl    String?

  // Sertifikat
  certificateIssuedAt  DateTime?

  // Keuangan
  invoiceNumber        String?
  paymentMethod        String?   @default("BANK_TRANSFER")
  paymentDate          DateTime?

  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model SopDocument {
  id              String    @id @default(uuid())
  code            String    @unique // e.g. SOP-OPS-001, REG-CORP-001
  category        String    // OPERASIONAL_UMROH, LEGALITAS_PERUSAHAAN, LAYANAN_JAMAAH, MITIGASI_DARURAT, KEUANGAN_REFUND, SDM_KODE_ETIK
  title           String    // Judul Dokumen / SOP
  purpose         String?   // Tujuan SOP
  scope           String?   // Ruang Lingkup
  responsibleRole String?   // Penanggung Jawab
  version         String    @default("1.0")
  effectiveDate   DateTime? @default(now())
  contentMarkdown String    // Isi Dokumen Lengkap Terstruktur
  tags            String?   // Tags Pencarian
  isMandatory     Boolean   @default(true) // Wajib Akreditasi / PPIU
  orderIndex      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

